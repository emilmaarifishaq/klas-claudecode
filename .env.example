# NextAuth - required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public app URL, no trailing slash. Used for Tripay callback/return URLs and emails.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXTAUTH_URL=https://your-app.vercel.app

# Postgres - auto-filled by Vercel when you attach a Postgres (Neon) database.
# Only set manually for local dev.
POSTGRES_URL=

# Tripay (https://tripay.co.id). Set TRIPAY_SANDBOX=false only with production keys.
TRIPAY_SANDBOX=true
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=

# Product
PRODUCT_NAME=KLAS Claude Code
PRODUCT_PRICE_IDR=99000

# Resend (https://resend.com) - sends login credentials after payment
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
