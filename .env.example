# NextAuth - required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-app.vercel.app

# Postgres - auto-filled by Vercel when you attach a Neon database. Tables are created automatically.
POSTGRES_URL=

# Your login, created/updated automatically on startup.
# Hash: node -e "require('bcryptjs').hash('PASSWORD',12).then(console.log)"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
